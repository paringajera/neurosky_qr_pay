# NeuroSky Pay — production environment for a single VPS behind Caddy.
# Rendered to /opt/neurosky-pay/.env by deploy/hostinger-vps/install.sh. Every __PLACEHOLDER__ is
# replaced by the installer. Secrets are generated once; keep this file private (chmod 600).

NODE_ENV=production
NEUROSKY_MODE=production

# Public base domain and hostname prefix. Services are published as
# <prefix>.<domain>, <prefix>-api.<domain>, <prefix>-admin.<domain>, <prefix>-gmail.<domain>.
# The variable name is historical: no Cloudflare account or tunnel is required when Caddy fronts the box.
CLOUDFLARE_DOMAIN=__DOMAIN__
DEPLOYMENT_PREFIX=__PREFIX__

# Internal service-to-service addresses (loopback). Caddy terminates HTTPS and proxies to these ports.
PAYMENT_API_URL=http://127.0.0.1:6100
BASE_PAYMENT_API_URL=http://127.0.0.1:6100
BASE_CHECKOUT_URL=https://__PREFIX__.__DOMAIN__
BASE_ADMIN_URL=https://__PREFIX__-admin.__DOMAIN__
BASE_DEMO_STORE_URL=https://__PREFIX__-store.__DOMAIN__
# Webhook URL seeded for the default (demo store) merchant on first boot. It must be public: loopback and
# private targets are rejected unless NEUROSKY_ALLOW_PRIVATE_WEBHOOKS=true. Change it in Merchant Admin
# (Developer Hub -> API Keys & Webhooks) when you connect your real store.
COIN_STORE_WEBHOOK_URL=https://__PREFIX__-store.__DOMAIN__/api/webhook
# Public origin of the demo store itself. Its post-payment return URL is built from this value and must be
# one of NEUROSKY_ALLOWED_RETURN_ORIGINS (it is, above).
COIN_STORE_PUBLIC_URL=https://__PREFIX__-store.__DOMAIN__

# Browser origins allowed to call the gateway, to receive return redirects, and to embed the checkout iframe.
# Add every storefront origin that loads neurosky.js (exact scheme + host, comma separated, no wildcards).
NEUROSKY_ALLOWED_ORIGINS=__MERCHANT_ORIGIN__,https://__PREFIX__.__DOMAIN__,https://__PREFIX__-admin.__DOMAIN__,https://__PREFIX__-store.__DOMAIN__
NEUROSKY_ALLOWED_RETURN_ORIGINS=__MERCHANT_ORIGIN__,https://__PREFIX__-store.__DOMAIN__
CHECKOUT_FRAME_ANCESTORS=__MERCHANT_ORIGIN__ https://__PREFIX__-store.__DOMAIN__

# Secrets (generated by the installer; rotating ENCRYPTION_MASTER_KEY makes stored OAuth credentials unreadable)
ENCRYPTION_MASTER_KEY=__ENCRYPTION_MASTER_KEY__
JWT_SECRET=__JWT_SECRET__
ADMIN_API_TOKEN=__ADMIN_API_TOKEN__
# OBSERVER_API_TOKEN, ANDROID_ENROLLMENT_SECRET and INTERNAL_SERVICE_TOKEN are generated automatically
# into data/.secrets/ on first boot and shared by all services on this host.

# Database (SQLite, WAL mode). Back up with deploy/hostinger-vps/backup.sh (installed as a nightly cron job).
SQLITE_DB_PATH=./data/neurosky_pay.sqlite

# Gmail observer: register exactly this redirect URI in Google Cloud Console (OAuth client -> Authorized redirect URIs).
GMAIL_REDIRECT_URI=https://__PREFIX__-gmail.__DOMAIN__/oauth/callback
# Set after you create and activate the receiving UPI account in Merchant Admin (Store Settings -> Receiving Accounts),
# then restart the service. Without it the Gmail observer stays in STANDBY.
# RECEIVING_ACCOUNT_ID=

# Observers: ALL | SMS_ONLY | GMAIL_ONLY. The legacy Chrome/Google Messages scraper stays disabled in production.
# With ALL the checkout shows "UPI Server Busy" until the Gmail observer is connected as well; use SMS_ONLY while you
# run only the Android SMS observer so customers see "Server Is Working".
NEUROSKY_OBSERVER_CHANNEL=ALL

# White-label defaults shown until the merchant overrides them in Store Settings.
DEFAULT_APP_NAME="NeuroSky Pay"
DEFAULT_PRIMARY_COLOR="#2563eb"
DEFAULT_SUPPORT_EMAIL="support@__DOMAIN__"
DEFAULT_SUPPORT_PHONE="9876543210"
DEFAULT_MERCHANT_NAME="NeuroSky Pay Store"
DEFAULT_MERCHANT_SLUG="store"

# Keep these unset in production:
#   NEUROSKY_EXPOSE_DEV_OTP, NEUROSKY_ALLOW_DEV_TOOLS, NEUROSKY_ALLOW_LOCALHOST_MODE, NEUROSKY_BIND_HOST
# Set NEUROSKY_ALLOW_PRIVATE_WEBHOOKS=true only if your store runs on a private LAN address.
